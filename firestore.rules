rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        request.auth.token.email == 'sr3056114@gmail.com'
      ); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Reusable validations
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId) || isAdmin();
    }

    match /userActivity/{activityId} {
      allow read, write: if isSignedIn();
    }

    match /adminUsers/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /kyc/{kycId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    match /demoWallets/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /demoLedger/{ledgerId} {
      allow read, write: if isSignedIn();
    }

    match /demoTrades/{tradeId} {
      allow read, write: if isSignedIn();
    }

    match /instruments/{instrumentId} {
      allow read: if true; // Public list
      allow write: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt is number;
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'status', 'updatedAt']) && incoming().updatedAt is number);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && incoming().adminId == request.auth.uid && incoming().timestamp is number;
    }

        match /marketControls/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /liveTrades/{tradeId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
        match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tournaments/{tourId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /marketData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /candles/{docId}/{allChildren=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /paymentMethods/{methodId} {
      allow read, write: if true;
    }
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /affiliates/{affId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /riskRules/{ruleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
